# ─────────────────────────────────────────────────────────────────────────────
# orgwise API — environment template
# Copy to `.env` and adjust. All variables are validated at boot (Joi) — the
# API refuses to start on missing/malformed values.
# ─────────────────────────────────────────────────────────────────────────────

# NestJS
NODE_ENV=development
PORT=3001

# Comma-separated allowlist of origins allowed to call the API with credentials.
#   CORS_ORIGINS=http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (required)
# Connection string consumed by Prisma.
DATABASE_URL=postgresql://orgwise:orgwise@localhost:5432/orgwise?schema=public

# Auth bridge — base URL of the Neon Auth (Managed Better Auth) server.
# The API validates session tokens against this server for RBAC enforcement.
# Same value as apps/web/.env.local NEON_AUTH_BASE_URL. REQUIRED in production.
NEON_AUTH_BASE_URL=https://your-branch.neonauth.us-east-2.aws.neon.build/neondb/auth
# How long a validated session stays cached in-memory (ms).
SESSION_CACHE_TTL_MS=60000

# Comma-separated emails granted the Admin role at first contact and
# re-promoted on every session (bootstrap admins). Case-insensitive.
#   ADMIN_EMAILS=you@example.com,ops@example.com
ADMIN_EMAILS=

# Global rate limiting — keyed by user id for authenticated traffic,
# by client IP for anonymous traffic.
# Window length (ms) and max requests per key per window.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Set to true when deployed behind a trusted reverse proxy so real client
# IPs (X-Forwarded-For from loopback) are honored for rate limiting.
# Keep false when the API is exposed directly.
TRUST_PROXY=false

# Developer tooling
# Off by default in production; set to true explicitly to expose docs there.
SWAGGER_ENABLED=true
# Served under the global prefix: /api/v1/{SWAGGER_PATH}
SWAGGER_PATH=docs

# Request logging (one line per request)
REQUEST_LOGGING_ENABLED=true

# AI Copilot (Workforce Copilot)
# Provider chain order: AI_PROVIDER (primary) -> Groq -> OpenRouter.
# Any provider without an API key is skipped automatically; on rate limit /
# timeout / error the next configured provider serves the request.
# AI_PROVIDER=groq | openrouter (default: groq)
AI_PROVIDER=groq
# Primary provider (OpenAI-compatible endpoints; only needed for AI_PROVIDER=openai)
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Per-user request limit for copilot chat
AI_REQUESTS_PER_MINUTE=10
# Max input characters per question (cost control)
AI_MAX_INPUT_CHARS=4000
# LLM request timeout (ms) and retries
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Max completion tokens
AI_MAX_TOKENS=2000
# Groq (free tier default model: llama-3.3-70b-versatile)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter (free tier default model: meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
