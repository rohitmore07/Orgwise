{
  "name": "@orgwise/api",
  "version": "0.1.0",
  "private": true,
  "description": "Orgwise API — NestJS backend service.",
  "scripts": {
    "prebuild": "prisma generate",
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "pnpm run build && node -r tsconfig-paths/register dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "eval:ai": "ts-node -r tsconfig-paths/register src/ai/copilot/eval/run-eval.ts",
    "build:lambda": "nest build",
    "package:lambda": "node scripts/package-lambda.mjs",
    "deploy": "node scripts/package-lambda.mjs && npx serverless deploy"
  },
  "dependencies": {
    "@codegenie/serverless-express": "^5.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@orgwise/types": "workspace:*",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "csv-parse": "^5.6.0",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "joi": "^17.0.0",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@orgwise/eslint-config": "workspace:*",
    "@types/aws-lambda": "^8.10.162",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.13.3",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "archiver": "^5.3.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "prisma": "^6.4.0",
    "serverless": "^3.40.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/(.*)$": "<rootDir>/$1"
    }
  }
}
