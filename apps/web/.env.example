# Public API base URL consumed by the browser.
# Matches the NestJS app's global prefix (/api/v1) and default port (3001).
# In production (e.g. Vercel) this MUST be the deployed API origin INCLUDING
# the /api/v1 prefix, e.g. https://<api-gateway>.execute-api.<region>.amazonaws.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Canonical site URL (used for metadataBase / Open Graph absolute URLs).
# Set to the real deployment URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Neon Auth (Managed Better Auth) ----
# Base URL of your Managed Better Auth server, from the Neon Console →
# Branch → Auth → Configuration (the neonauth.*.neon.build URL for your branch).
NEON_AUTH_BASE_URL=https://your-branch.neonauth.us-east-2.aws.neon.build/neondb/auth

# Secret for signing session cookies (HMAC-SHA256, min 32 chars).
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=your-secret-at-least-32-characters-long

# NOTE — email/password sign-in:
# Neon Auth enables 'Email verification required' by default, which blocks
# sign-in until the address is verified (EMAIL_NOT_VERIFIED). For evaluation
# turn it off in Neon Console → Branch → Auth → Settings, or configure
# Google/GitHub OAuth there instead.

# ---- Security ----
# Minutes of inactivity before the app signs the user out automatically
# (protects sensitive workforce data on shared devices). 0 or unset = 30.
NEXT_PUBLIC_SESSION_IDLE_MINUTES=30
